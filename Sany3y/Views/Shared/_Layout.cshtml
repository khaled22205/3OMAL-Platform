<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - عمَّال</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sany3y.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />
</head>
<body dir="rtl">
    @{
        await Html.RenderPartialAsync("_Header");
        <partial name="_Loader" />
        <partial name="_Notification" />
    }

    @{
        var path = Context.Request.Path.Value?.ToLower();
        var isHomePage = path == "/" || path == "/home" || path == "/home/index";
        var isAccessDeniedPage = path == "/home/accessdenied";
        var isNotFoundPage = path == "/home/notfoundpage";
        var isError500Page = path == "/home/error500";
        var isLockedOut = path == "/account/lockout";
        var mainClass = isHomePage ? "pb-3" : (isAccessDeniedPage || isNotFoundPage || isError500Page || isLockedOut) ? "pt-5" : "pt-5 pb-3 mt-5";
    }

    <div class="@mainClass">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <button id="scrollTopBtn" title="Go to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    @{await Html.RenderPartialAsync("_Footer");}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Global CSS variable overrides to enforce modern theme colors across views with page-level overrides -->
    <style>
        :root {
            --primary-green: #6366f1 !important;
            --primary-green-dark: #4f46e5 !important;
            --primary-green-darker: #3730a3 !important;
            --primary-green-light: #818cf8 !important;
            --primary-green-lighter: #a5b4fc !important;
            --primary-green-pale: #e0e7ff !important;
            --accent-yellow: #00d2ff !important;
            --accent-yellow-dark: #00b4db !important;
            --accent-yellow-darker: #0083b0 !important;
            --accent-gold: #00d2ff !important;
            --accent-gold-light: #38bdf8 !important;
            --accent-gold-pale: #f0f9ff !important;
            --bg-light: #f8fafc !important;
            --bg-white: #ffffff !important;
            --bg-gray: #f1f5f9 !important;
            --text-primary: #0f172a !important;
            --text-secondary: #475569 !important;
            --text-muted: #94a3b8 !important;
            --border-light: #e2e8f0 !important;
            --border-medium: #cbd5e1 !important;
         }
         /* Custom enhancements for modern look */
         body {
             font-family: 'Cairo', sans-serif !important;
             background-attachment: fixed !important;
             background-image: radial-gradient(circle at 5% 15%, rgba(99, 102, 241, 0.1) 0%, transparent 35%),
                               radial-gradient(circle at 95% 85%, rgba(6, 182, 212, 0.1) 0%, transparent 35%),
                               radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 45%),
                               linear-gradient(180deg, #f8fafc 0%, #ffffff 100%) !important;
         }
         .btn-primary {
             background-color: var(--primary-green) !important;
             border-color: var(--primary-green) !important;
             color: white !important;
         }
         .btn-primary:hover {
             background-color: var(--primary-green-dark) !important;
             border-color: var(--primary-green-dark) !important;
             color: white !important;
             transform: translateY(-2px);
             box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25) !important;
         }
         .btn-warning {
             background-color: var(--accent-yellow) !important;
             border-color: var(--accent-yellow) !important;
             color: white !important;
         }
         .btn-warning:hover {
             background-color: var(--accent-yellow-dark) !important;
             border-color: var(--accent-yellow-dark) !important;
             color: white !important;
         }
        /* Soften the card styling */
        .card {
            border-radius: 16px !important;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.04) !important;
            border: 1px solid rgba(226, 232, 240, 0.8) !important;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(8px);
        }
        /* Premium custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</body>
</html>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            var swiper = new Swiper(".mySwiper", {
                slidesPerView: 1,
                spaceBetween: 30,
                loop: true,
                autoplay: {
                    delay: 3000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                breakpoints: {
                    576: { slidesPerView: 1 },
                    768: { slidesPerView: 2 },
                    992: { slidesPerView: 3 },
                    1200: { slidesPerView: 4 },
                }
            });

            $(".filter-btn").click(function () {

                $(".filter-btn").removeClass("active");
                $(this).addClass("active");

                let categoryId = $(this).data("id");

                $.ajax({
                    url: "/api/Technician/GetByCategory/" + categoryId,
                    method: "GET",
                    success: async function (technicians) {
                        let grid = $("#technicians-grid");
                        grid.empty();

                        // جلب الصور لكل فني
                        for (const t of technicians.slice(0, 8)) {
                            let profileUrl = 'https://placehold.co/300x200?text=Technician';

                            if (t.profilePictureId) {
                                try {
                                    let picResponse = await fetch("/api/ProfilePicture/GetById/" + t.profilePictureId);
                                    if (picResponse.ok) {
                                        let picData = await picResponse.json();
                                        if (picData.path) profileUrl = picData.path;
                                    }
                                } catch (err) {
                                    console.error("Error fetching profile picture:", err);
                                }
                            }

                            if (t.isShop) continue;

                            let card = `
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <div class="tech-card h-100 d-flex flex-column">
                                        <div class="tech-img-wrapper">
                                            <img src="${profileUrl}" class="tech-img" />
                                        </div>
                                        <div class="card-body p-3 text-center d-flex flex-column justify-content-between flex-grow-1">
                                            <div>
                                                <h5 class="fw-bold mb-2" style="font-family: 'Cairo', sans-serif; color: var(--text-dark); font-size: 1.15rem;">${t.firstName} ${t.lastName}</h5>
                                                <div class="mb-3 d-flex flex-column align-items-center gap-1">
                                                    <span style="font-size: 0.82rem; color: #6366f1; background: rgba(99, 102, 241, 0.08); padding: 3px 12px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                                                        <i class="fas fa-tools text-primary" style="font-size: 0.75rem;"></i> ${t.category ? (t.category.name || t.category.Name) : (t.categoryName || 'فني')}
                                                    </span>
                                                    <span class="text-muted" style="font-size: 0.8rem; display: inline-flex; align-items: center; gap: 4px;">
                                                        <i class="fas fa-map-marker-alt text-danger" style="font-size: 0.75rem;"></i> ${t.address ? (t.address.city || t.address.City) : (t.city || 'غير محدد')}
                                                    </span>
                                                </div>
                                            </div>
                                            <a href="/Services/Details/${t.id}" class="btn btn-outline-primary btn-sm w-100 rounded-pill" style="border-color: var(--primary-green); color: var(--primary-green); font-weight: 600; transition: all 0.25s;">
                                                عرض الملف الشخصي
                                            </a>
                                        </div>
                                    </div>
                                </div>`;

                            grid.append(card);
                        }
                    }
                });
            });

            // تحميل الكل أول ما الصفحة تفتح
            $(".filter-btn[data-id='0']").click();
        });
    </script>
}

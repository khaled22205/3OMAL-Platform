@using Sany3y.Infrastructure.Models

@{
    var sender = ViewBag.Sender as User;
    var receiver = ViewBag.Receiver as User;
    ViewData["Title"] = "المحادثات";
}

<div class="container-fluid my-4 pt-5">
    <div class="row g-3" style="height: 75vh; min-height: 550px;">
        <!-- قائمة المحادثات (Sidebar) -->
        <div class="col-md-4 col-lg-3 h-100">
            <div class="card h-100 shadow-sm border-0 d-flex flex-column overflow-hidden">
                <div class="card-header bg-primary text-white py-3 fw-bold">
                    <i class="fas fa-comments me-2"></i> المحادثات الأخيرة
                </div>
                <div class="list-group list-group-flush flex-grow-1 overflow-y-auto" style="max-height: calc(75vh - 60px);">
                    @{
                        var partners = ViewBag.ChatPartners as List<User> ?? new List<User>();
                        if (partners.Any())
                        {
                            foreach (var partner in partners)
                            {
                                var isActive = receiver != null && partner.Id == receiver.Id ? "active bg-light text-dark fw-bold border-emerald" : "";
                                <a asp-controller="Account" asp-action="Chat" asp-route-id="@partner.Id" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 @isActive">
                                    <div class="position-relative me-3">
                                        <img src="https://placehold.co/50x50?text=@partner.UserName[0]" class="rounded-circle shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" />
                                        @if (partner.IsOnline)
                                        {
                                            <span class="position-absolute bottom-0 start-0 translate-middle p-1 bg-success border border-white rounded-circle" style="width: 12px; height: 12px; transform: translate(-25%, -25%);"></span>
                                        }
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <h6 class="mb-0 fw-bold">@partner.FirstName @partner.LastName</h6>
                                        </div>
                                        <small class="text-muted d-block text-truncate">@@@partner.UserName</small>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted p-4 my-auto">
                                <i class="fas fa-comment-slash fa-3x mb-3 text-muted opacity-50"></i>
                                <p class="mb-0">لا توجد محادثات سابقة</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- صندوق المحادثة النشطة (Active Chat Area) -->
        <div class="col-md-8 col-lg-9 h-100">
            <div class="card h-100 shadow-sm border-0 d-flex flex-column overflow-hidden">
                @if (receiver != null)
                {
                    <!-- الهيدر -->
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img src="@ViewBag.ReceiverImage" class="rounded-circle shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" />
                            <div class="ms-3">
                                <h6 class="mb-0 fw-bold">@receiver.FirstName @receiver.LastName</h6>
                                <small id="chatStatus" class="text-muted">
                                    @if (receiver.IsOnline)
                                    {
                                        <span class="text-success"><i class="fas fa-circle font-xs me-1"></i> متصل الآن</span>
                                    }
                                    else
                                    {
                                        <span>غير متصل</span>
                                    }
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- الرسائل -->
                    <div id="messages" class="card-body bg-light overflow-y-auto flex-grow-1 p-3" style="background-color: #f8fafc !important;">
                        <!-- Messages will load dynamically -->
                    </div>

                    <!-- يكتب الآن -->
                    <div id="typing" class="px-3 py-2 bg-light text-muted small fst-italic" style="display: none; background-color: #f8fafc !important;">
                        <span class="spinner-grow spinner-grow-sm me-1 text-success" role="status"></span>
                        يكتب الآن...
                    </div>

                    <!-- الإدخال -->
                    <div class="card-footer bg-white py-3 border-0">
                        <div class="input-group">
                            <input id="msg" type="text" class="form-control border px-4 py-2 bg-light border-0 rounded-pill-start" placeholder="اكتب رسالتك هنا..." style="border-radius: 30px 0 0 30px;" />
                            <button id="sendBtn" class="btn btn-primary px-4" style="border-radius: 0 30px 30px 0;">
                                <i class="fas fa-paper-plane me-1"></i> إرسال
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted p-5 my-auto">
                        <i class="far fa-comments fa-4x mb-3 text-emerald opacity-50 animate__animated animate__pulse animate__infinite" style="color: var(--primary-green);"></i>
                        <h5 class="fw-bold">صندوق المحادثات</h5>
                        <p class="text-center mb-0">اختر محادثة من القائمة الجانبية للبدء أو تواصل مع صنايعي مباشرة من صفحة الخدمات.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .border-emerald {
        border-right: 4px solid var(--primary-green) !important;
    }

    .message {
        max-width: 65%;
        padding: 10px 16px;
        border-radius: 18px;
        margin-bottom: 12px;
        line-height: 1.5;
        font-size: 0.95rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .received {
        background: white;
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        margin-right: auto;
        border-bottom-right-radius: 4px;
    }

    .sent {
        background: var(--primary-green);
        color: white;
        margin-left: auto;
        border-bottom-left-radius: 4px;
    }

    .time {
        font-size: 0.7rem;
        opacity: .7;
        margin-top: 4px;
        text-align: left;
    }
    
    .sent .time {
        text-align: right;
    }

    .list-group-item.active {
        border-right: 4px solid var(--primary-green) !important;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const sender = "@(sender?.UserName ?? "")";
        const receiver = "@(receiver?.UserName ?? "")";
        const senderId = @(sender?.Id ?? 0);
        const receiverId = @(receiver?.Id ?? 0);
        const apiBase = "https://localhost:7178";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        // جلب الرسائل القديمة
        async function loadOldMessages() {
            if (receiverId === 0) return;
            try {
                const res = await fetch(`${apiBase}/api/Message/GetConversation/${senderId}/${receiverId}`);
                const messages = await res.json();
                messages.forEach(m => {
                    const isSent = m.senderId === senderId;
                    addMessage(isSent, m.content, new Date(m.sentAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}));
                });
                scrollDown();
            } catch (err) {
                console.error("Failed to load messages:", err);
            }
        }

        // إضافة رسالة في الواجهة
        function addMessage(isSent, message, time) {
            const div = `
                <div class="message ${isSent ? "sent" : "received"}">
                    <div>${message}</div>
                    <div class="time">${time}</div>
                </div>
            `;
            $("#messages").append(div);
            scrollDown();
        }

        function scrollDown() {
            var chatBox = document.getElementById("messages");
            if (chatBox) {
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        }

        // استقبال رسائل من SignalR
        connection.on("ReceiveMessage", (from, message, time) => {
            if (from === receiver) addMessage(false, message, time);
        });

        connection.on("MessageSent", (to, message, time) => {
            if (to === receiver) addMessage(true, message, time);
        });

        connection.on("TypingIndicator", (username) => {
            if (username === receiver) {
                $("#typing").show();
                setTimeout(() => $("#typing").hide(), 1200);
            }
        });

        connection.start().then(() => {
            console.log("Connected to Chat Hub");
        });

        $("#sendBtn").click(sendMessage);
        $("#msg").on("input", () => {
            if (receiver) connection.invoke("Typing", receiver);
        });
        $("#msg").keypress(e => { if (e.which === 13) sendMessage(); });

        async function sendMessage() {
            let message = $("#msg").val().trim();
            if (!message || !receiver) return;

            // إرسال عبر SignalR
            connection.invoke("SendPrivateMessage", receiver, message);
            $("#msg").val("");
        }

        // تحميل الرسائل القديمة عند التحميل
        $(document).ready(loadOldMessages);
    </script>
}
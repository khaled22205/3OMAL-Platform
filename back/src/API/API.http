@baseUrl = http://localhost:5000
@adminToken = {{loginAdmin.response.body.data.accessToken}}
@customerToken = {{registerCustomer.response.body.data.accessToken}}
@workerToken = {{registerWorker.response.body.data.accessToken}}

### ============================================
### AUTH ENDPOINTS
### ============================================

### Register a new customer
# @name registerCustomer
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "firstName": "Ahmed",
  "lastName": "Ali",
  "email": "customer@test.com",
  "password": "Test@123",
  "phoneNumber": "01000000001",
  "userType": "Customer"
}

### Register a new worker
# @name registerWorker
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "firstName": "Mohamed",
  "lastName": "Hassan",
  "email": "worker@test.com",
  "password": "Test@123",
  "phoneNumber": "01000000002",
  "userType": "Worker"
}

### Register another worker
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "firstName": "Ali",
  "lastName": "Omar",
  "email": "worker2@test.com",
  "password": "Test@123",
  "phoneNumber": "01000000003",
  "userType": "Worker"
}

### Login as admin (seeded by default)
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@3omal.com",
  "password": "Admin@123"
}

### Login as customer
# @name loginCustomer
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "customer@test.com",
  "password": "Test@123"
}

### Login as worker
# @name loginWorker
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "worker@test.com",
  "password": "Test@123"
}

### Refresh token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginAdmin.response.body.data.refreshToken}}"
}

### Get current user (me)
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{adminToken}}

### Change password
POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "currentPassword": "Test@123",
  "newPassword": "NewTest@123"
}

### Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{customerToken}}

### ============================================
### CATEGORIES ENDPOINTS
### ============================================

### Get all categories (tree)
GET {{baseUrl}}/api/v1/categories

### Get category by ID
GET {{baseUrl}}/api/v1/categories/1

### Create a new category (Admin)
# @name createCategory
POST {{baseUrl}}/api/v1/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Plumbing",
  "description": "All plumbing services including pipe repair, installation, and maintenance",
  "icon": "🔧",
  "seoUrl": "plumbing",
  "sortOrder": 1,
  "isActive": true
}

### Create subcategory (Admin)
POST {{baseUrl}}/api/v1/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pipe Repair",
  "description": "Fix leaking or burst pipes",
  "icon": "🔩",
  "seoUrl": "pipe-repair",
  "parentCategoryId": 1,
  "sortOrder": 1,
  "isActive": true
}

